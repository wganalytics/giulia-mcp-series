# PRJ-08 agent_to_agent — copie para .env e preencha.

# --- Modelo LLM (multi-provider via LiteLLM) ---
# Escolha UM formato e configure a chave correspondente abaixo:
#   OpenAI     -> gpt-4o-mini
#   Anthropic  -> anthropic/claude-3-5-sonnet-20240620
#   Gemini     -> gemini/gemini-1.5-flash
#   OpenRouter -> openrouter/openai/gpt-4o-mini
LLM_MODEL=gpt-4o-mini

# --- Chaves (preencha só a do provider escolhido) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# --- Endereços A2A (servidor e cliente devem combinar) ---
A2A_HOST=localhost
A2A_PORT=9999
A2A_SERVER_URL=http://localhost:9999

# Evita o prompt interativo de tracing do CrewAI em execução automatizada
CREWAI_TRACING_ENABLED=false
