# PRJ-02 mcp_client — copie para .env e preencha.

# Modelo LLM (multi-provider via LiteLLM):
#   OpenAI     -> gpt-4o-mini
#   Anthropic  -> anthropic/claude-3-5-sonnet-20240620
#   Gemini     -> gemini/gemini-1.5-flash
#   OpenRouter -> openrouter/openai/gpt-4o-mini
LLM_MODEL=gpt-4o-mini

# Preencha só a chave do provider escolhido:
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
